    st_arg = f"st{sites}"
    ip_arg = f"ip{iters}-{procs}"


    print("   Results folder: ",results_path)
    print("   Job:", job)
    print("   Sites:", sites)
    print("   Mode:", mode)

    cmd = ["./bin/MTpostprocess.py", results_path, st_arg, ip_arg, xaxis ] 

    # mode = str(mode)
    if mode != "none":
      cmd.append(mode)


    subprocess.run(cmd, check=True)

